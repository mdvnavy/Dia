# Copy to .env and fill in. Either key enables live Gemini agent runs.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Make MCP Toolbox (optional): the agent connects to this curated MCP server
# and gains its published scenario tools. Leave unset to run without it.
MAKE_MCP_URL=
MAKE_MCP_TOKEN=
# GCP-managed MCP server (optional): a Google Cloud MCP endpoint, e.g.
# https://monitoring.googleapis.com/mcp. Auth comes from ADC (gcloud auth
# application-default login), not an API key. Leave unset to run without it.
GCP_MCP_URL=
# MCP tools are attached ONLY by explicit config (never by words in a prompt):
# none (default) | make | gcp | all
DIA_AGENT_MCP_MODE=none
# Live agent access (/api/agent). Visitors get DIA_AGENT_DAILY_LIMIT questions
# per calendar day (America/New_York). Owners sign in with Google and are
# unlimited. Sign-in shows only when GOOGLE_CLIENT_ID and DIA_SESSION_SECRET
# are both set; otherwise everyone gets the visitor cap.
# GOOGLE_CLIENT_ID is the public OAuth Web client ID (*.apps.googleusercontent.com).
GOOGLE_CLIENT_ID=
# Comma-separated, case-insensitive. Any other Google account = a visitor.
OWNER_EMAILS=
# Signs the 12h session cookie (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In Cloud Run, supply it from Secret Manager, not plain env.
DIA_SESSION_SECRET=
DIA_AGENT_DAILY_LIMIT=10
# Shared counters across instances: firestore (recommended on Cloud Run) or
# memory (default; per instance and reset on restart).
DIA_QUOTA_STORE=memory
# DIA_FIRESTORE_PROJECT=
# DIA_FIRESTORE_DATABASE=(default)
# DIA_FIRESTORE_COLLECTION=dia_agent_quota
# Secret salt for hashing visitor IPs/cookies before they're stored.
DIA_VISITOR_SALT=
# Per-IP burst guard as calls/seconds (0 disables).
DIA_AGENT_RATE_LIMIT=10/60
# Client memory Sheet (optional): the ID of a Google Sheet with `clients` and
# `engagements` tabs — DIA recalls repeat clients and records every scored
# intake there. Auth is ADC (spreadsheets scope); share the Sheet with the
# service-account email when deployed. Leave unset to run memoryless.
MEMORY_SHEET_ID=

# Donate link (plus menu, command palette, DIA menu). Must be https://. Leave commented to use the built-in default
# (https://www.paypal.com/ncp/payment/PQGR9B44BEYLU); set it to an empty value to hide Donate.
# DIA_DONATE_URL=
