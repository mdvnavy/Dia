# Copy to .env and fill in. Live Gemini agent runs use Vertex AI ONLY, with
# Application Default Credentials (locally: gcloud auth application-default
# login). GEMINI_API_KEY / GOOGLE_API_KEY are ignored even if set.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
# global (or the us / eu multi-region): current Gemini models are not served
# from single regions such as us-central1.
GOOGLE_CLOUD_LOCATION=global
# Ask DIA model. Defaults to gemini-3.8-flash (gemini-2.5-flash was retired on 2026-10-20).
# DIA_MODEL=gemini-3.8-flash
# Make MCP Toolbox (optional): the agent connects to this curated MCP server
# and gains its published scenario tools. Leave unset to run without it.
MAKE_MCP_URL=
MAKE_MCP_TOKEN=
# GCP-managed MCP server (optional): a Google Cloud MCP endpoint, e.g.
# https://monitoring.googleapis.com/mcp. Auth comes from ADC (gcloud auth
# application-default login), not an API key. Leave unset to run without it.
GCP_MCP_URL=
# MCP tools are attached ONLY by explicit config (never by words in a prompt):
# none (default) | make | gcp | all
DIA_AGENT_MCP_MODE=none
# --- Lockdown v2: no use without signing in (same as Tia) ---------------------
# Signed out, DIA is read-only (landing page, How it works, static files,
# /api/config, health). Every functional route answers 401 sign_in_required.
# Signed-in free users get DIA_GENERATION_DAILY_LIMIT generations and
# DIA_ASK_DAILY_LIMIT Ask DIA questions per day (reset at midnight
# America/Toronto). Owners are unlimited.
#
# Kill switch for Ask DIA (/api/agent): OFF unless exactly 1/true/yes/on.
# Off = a calm 503 for everyone, owners included, before any model or quota call.
ASK_DIA_ENABLED=false
# Public OAuth Web client ID (*.apps.googleusercontent.com). Unset = nobody can
# sign in, so every functional route is closed.
GOOGLE_CLIENT_ID=
# Comma-separated owner emails (trimmed, case-insensitive). Matched only
# against the verified ID token's email with email_verified=true.
OWNER_EMAILS=
# Signs the session cookie (min 32 chars). Supply from Secret Manager on
# Cloud Run, never plain env or a file. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DIA_SESSION_SECRET=
# Session lifetime in seconds (default 7200; clamped to 300..43200).
# DIA_SESSION_TTL_SECONDS=7200
DIA_GENERATION_DAILY_LIMIT=10
DIA_ASK_DAILY_LIMIT=5
# Shared counters across instances: firestore (required on Cloud Run) or
# memory (default; per instance and reset on restart).
DIA_QUOTA_STORE=memory
# Firestore Native-mode database for the counters (the (default) database of
# the live project is Datastore mode, so use a separate Native one).
# Add a TTL policy on field expire_at of collection DIA_FIRESTORE_COLLECTION.
# DIA_FIRESTORE_PROJECT=
# DIA_FIRESTORE_DATABASE=dia-quota
# DIA_FIRESTORE_COLLECTION=dia_agent_quota
# Secret salt for hashing user ids and sign-in IPs before they're stored.
DIA_VISITOR_SALT=
# Burst guards as calls/seconds (off disables). Per verified user:
# DIA_BURST_LIMIT=3/10          # generations and Ask DIA (each)
# DIA_UTILITY_BURST_LIMIT=10/10 # extract, PDF export
# Per salted IP hash, sign-in endpoint only:
# DIA_AUTH_RATE_LIMIT=10/60
# LOCAL DEVELOPMENT ONLY: treat requests without a session as an uncapped
# developer. Ignored on Cloud Run (K_SERVICE set). Never set it anywhere public.
# DIA_LOCAL_DEV_NO_SIGN_IN=true
# Client memory Sheet (optional): the ID of a Google Sheet with `clients` and
# `engagements` tabs — DIA recalls repeat clients and records every scored
# intake there. Auth is ADC (spreadsheets scope); share the Sheet with the
# service-account email when deployed. Leave unset to run memoryless.
MEMORY_SHEET_ID=

# Donate link (plus menu, command palette, DIA menu). Must be https://. Leave commented to use the built-in default
# (https://www.paypal.com/ncp/payment/PQGR9B44BEYLU); set it to an empty value to hide Donate.
# DIA_DONATE_URL=
